# Rust build output
/target
**/*.rs.bk
*.pdb
*.tmp
# Cargo.lock is committed: the exact dependency graph is part of the reproducible
# build, and a round trip asserted octet for octet cannot rest on a graph that moves
# between two builds of one commit.

# cargo-mutants working output.
/mutants.out/
/mutants.out.old/
/mutants-*

# mise local overrides (per-developer, never committed)
/mise.local.toml
/.mise.local.toml

# Editor / OS
/.idea/
/.vscode/
*.swp
.DS_Store
Thumbs.db
.claude/
